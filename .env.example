# Sample environment file.
# Copy this file to ".env" and change the values. Never commit ".env".
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env

# ---- Server ---------------------------------------------------------------
# Port the trainer service listens on.
SERVER_PORT=8082

# ---- Database (MySQL) -----------------------------------------------------
# Host and port the app uses to reach MySQL when you run it on your machine.
# docker-compose.yml publishes MySQL on DB_PORT, and overrides these two for
# the app container (inside Docker it uses trainer-db:3306).
DB_HOST=localhost
DB_PORT=3308
DB_NAME=sportsaura_trainer
DB_USERNAME=sportsaura
DB_PASSWORD=change-me-app-password
# Password of the MySQL root user. Only used by docker-compose to create the database.
DB_ROOT_PASSWORD=change-me-root-password

# ---- JWT (login tokens) ---------------------------------------------------
# MUST be exactly the same value as JWT_SECRET in the user service's .env.
# The user service signs tokens with it; this service checks them with it.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# ---- Dev tools (docker-compose.tools.yml) ---------------------------------
# Port of phpMyAdmin for this service's database.
PHPMYADMIN_PORT=8091
